# Copy to .env (or .env.local) and fill in. Never commit real secrets — .env* is gitignored.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only SECRET key (sb_secret_… / legacy service_role). BYPASSES RLS —
# never prefix with NEXT_PUBLIC_ and never use outside lib/supabase/admin.ts.
# Required for platform-admin "View as user" impersonation. Set in Vercel
# (preview + prod) as well as here.
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (profile photos & resumes) -------------------------------
# See docs/R2_SETUP.md for how to obtain these. Server-only — do NOT prefix with
# NEXT_PUBLIC_ (these must never reach the browser).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=careerlaunchpad-profiles
# Public domain bound to the bucket for serving photos (e.g. https://cdn.example.com
# or the bucket's r2.dev URL). Leave blank to keep everything private/presigned.
R2_PUBLIC_BASE_URL=

# --- Email (transactional notifications via SMTP, e.g. Zoho Mail) -----------
# Generic SMTP. For Zoho: host smtppro.zoho.in, port 465 (SSL) or 587 (STARTTLS),
# SMTP_USER = the full mailbox address, SMTP_PASSWORD = a Zoho app-specific
# password (generate one with 2FA on the mailbox). Leave SMTP_* blank to keep
# logging emails to the console instead of sending. Server-only — never NEXT_PUBLIC_.
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USER=noreply@careerlaunchpad.ai
SMTP_PASSWORD=
# Visible From. MAIL_FROM_ADDRESS must be a mailbox/alias SMTP_USER may send as
# (defaults to SMTP_USER if blank). MAIL_FROM_NAME is the friendly display name.
MAIL_FROM_ADDRESS=noreply@careerlaunchpad.ai
MAIL_FROM_NAME=CareerLaunchpad

# --- Zoom (auto-created meetings for scheduled classes) ---------------------
# Server-to-Server OAuth app credentials. See docs/ZOOM_SETUP.md to create the
# app and obtain these. Used ONLY by lib/zoom (server-only) — never prefix with
# NEXT_PUBLIC_. Leave blank to disable Zoom: classes still schedule (with
# meeting_status='failed' or a manually-pasted link), nothing breaks. Set in
# Vercel (preview + prod) as well as here.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# --- Google Maps Platform (address auto-fill + pin map) ---------------------
# Registration walkthrough: docs/GOOGLE_MAPS_REGISTER_AND_ENV.md
# TWO keys on purpose. A JS map cannot work without a key the browser can read,
# so sharing one would publish the geocoding key to every visitor.
#   GOOGLE_MAPS_SERVER_KEY  — Geocoding API + Places API (NEW). Server-only:
#     never add a NEXT_PUBLIC_ prefix. Restrict it by API in the Cloud console;
#     leave Application restrictions = None (Vercel egress IPs are dynamic).
#   NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY — Maps JavaScript API only, restricted by
#     HTTP referrer (include https://*.vercel.app/* or previews break).
# Leave BOTH blank to disable address lookup: the "Pin on map" button is hidden and the
# endpoints report "not configured". The form still works — students type the fields.
GOOGLE_MAPS_SERVER_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Our own per-SKU monthly ceiling, under Google's 10,000 free calls. Past it the
# app falls back to the local catalogue rather than spending. The console quota
# is the real stop — this cannot block a request made with a leaked key.
GEO_PROVIDER_MONTHLY_CAP=9500

# --- Scheduled jobs (Vercel Cron) -------------------------------------------
# Shared secret for the cron endpoints in app/api/cron/*. Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` on every scheduled invocation, and the routes
# REFUSE TO RUN when it is unset — a job that emails students must never be callable
# by anyone who knows the URL. Generate with `openssl rand -hex 32` and set it in
# Vercel (preview + prod). Locally you only need it to test a job by hand.
# Schedule lives in vercel.json: /api/cron/feedback-reminders daily at 04:30 UTC
# (10:00 IST) — the single chapter-feedback reminder (issue #84).
CRON_SECRET=
